meta {
  name: List transactions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/transactions?page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns a paged list for the logged-in customer only", function () {
    expect(res.status).to.equal(200);
    expect(res.body.content).to.be.an("array");
    expect(res.body.page.size).to.equal(20);
    res.body.content.forEach(function (tx) {
      expect(tx.reference).to.match(/^TXN-/);
    });
  });
}
