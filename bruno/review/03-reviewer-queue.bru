meta {
  name: Reviewer sees the queue with customer IDs
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/review/disputes?status=SUBMITTED
  body: none
  auth: bearer
}

auth:bearer {
  token: {{reviewerToken}}
}

tests {
  test("queue lists submitted disputes with the customer ID", function () {
    expect(res.status).to.equal(200);
    expect(res.body.content).to.be.an("array").that.is.not.empty;
    res.body.content.forEach(function (d) {
      expect(d.status).to.equal("SUBMITTED");
      expect(d.customerId).to.be.a("string");
    });
  });
}
