meta {
  name: Reviewer starts the review
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/review/disputes/{{reviewDisputeId}}/start
  body: none
  auth: bearer
}

auth:bearer {
  token: {{reviewerToken}}
}

tests {
  test("dispute moves to UNDER_REVIEW", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("UNDER_REVIEW");
  });
}
