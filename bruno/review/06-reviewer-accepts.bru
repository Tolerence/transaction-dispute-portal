meta {
  name: Reviewer accepts the dispute
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/review/disputes/{{reviewDisputeId}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reviewerToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "decision": "ACCEPT",
    "note": "Merchant confirmed the duplicate charge. A refund is being processed."
  }
}

tests {
  test("dispute is ACCEPTED with three timeline events", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("ACCEPTED");
    expect(res.body.events).to.have.lengthOf(3);
  });
}
