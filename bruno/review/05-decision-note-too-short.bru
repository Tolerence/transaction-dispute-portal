meta {
  name: Decision rejected when the note is too short
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/review/disputes/{{reviewDisputeId}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reviewerToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "decision": "ACCEPT",
    "note": "ok"
  }
}

tests {
  test("returns 400 with a field error", function () {
    expect(res.status).to.equal(400);
    expect(res.body.errors.note).to.be.a("string");
  });
}
