meta {
  name: Submit dispute
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/transactions/{{transactionId}}/disputes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reason": "UNAUTHORISED_TRANSACTION",
    "description": "I did not authorise this payment. Please investigate."
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("disputeId", res.body.id);
  }
}

tests {
  test("creates a SUBMITTED dispute with an audit event", function () {
    expect(res.status).to.equal(201);
    expect(res.body.status).to.equal("SUBMITTED");
    expect(res.body.events).to.have.lengthOf(1);
    expect(res.headers.location).to.match(/^\/api\/disputes\/\d+$/);
  });
}
