meta {
  name: Get dispute detail (timeline)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/disputes/{{disputeId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns the dispute with its event timeline", function () {
    expect(res.status).to.equal(200);
    expect(res.body.events).to.be.an("array").that.is.not.empty;
  });
}
