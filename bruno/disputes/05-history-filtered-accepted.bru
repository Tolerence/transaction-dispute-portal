meta {
  name: Dispute history filtered by ACCEPTED
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/disputes?status=ACCEPTED
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("only accepted disputes are returned", function () {
    expect(res.status).to.equal(200);
    res.body.content.forEach(function (d) {
      expect(d.status).to.equal("ACCEPTED");
    });
  });
}
