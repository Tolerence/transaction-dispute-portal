meta {
  name: Second open dispute on same transaction is rejected
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/transactions/{{transactionId}}/disputes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reason": "DUPLICATE_CHARGE",
    "description": "Charged twice for the same payment."
  }
}

tests {
  test("returns 422 when an open dispute already exists", function () {
    expect(res.status).to.equal(422);
  });
}
