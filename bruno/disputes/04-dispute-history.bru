meta {
  name: Dispute history (all statuses)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/disputes?page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("every dispute has a known status", function () {
    expect(res.status).to.equal(200);
    expect(res.body.content).to.be.an("array");
    res.body.content.forEach(function (d) {
      expect(["SUBMITTED", "UNDER_REVIEW", "ACCEPTED", "REJECTED", "WITHDRAWN"]).to.include(d.status);
    });
  });
}
