meta {
  name: Dev login (local token, dev profile)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/dev/token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerId": "{{customerId}}"
  }
}

script:pre-request {
  if (bru.getEnvVar("authMode") !== "dev") {
    bru.runner.skipRequest();
  }
}

script:post-response {
  if (res.body && res.body.accessToken) {
    bru.setVar("accessToken", res.body.accessToken);
  }
}

tests {
  test("returns 200 with an access token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessToken).to.be.a("string");
  });
}
