meta {
  name: Dev reviewer login (local token with DISPUTE_REVIEWER role)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/dev/token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerId": "{{reviewerId}}",
    "roles": ["DISPUTE_REVIEWER"]
  }
}

script:pre-request {
  if (bru.getEnvVar("authMode") !== "dev") {
    bru.runner.skipRequest();
  }
}

script:post-response {
  if (res.body && res.body.accessToken) {
    bru.setVar("reviewerToken", res.body.accessToken);
  }
}

tests {
  test("issues a reviewer token", function () {
    expect(res.status).to.equal(200);
  });
}
