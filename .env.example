# Copy to .env and replace every value. Never commit .env.
# Start with: make env && make up   (see README)

# ---- Database (required everywhere) -----------------------------------------------------------
DB_PASSWORD=change-me

# ---- Identity provider (production) ----------------------------------------------------------
# Issuer exactly as it appears in token "iss" claims, e.g. https://login.example.com/realms/bank
OIDC_ISSUER_URI=
# Optional: where the API fetches signing keys from, when it reaches the provider on another address.
OIDC_JWK_SET_URI=
APP_AUDIENCE=dispute-portal-api
# Browsers send Origin on every POST, even same-origin. Origins must be listed here or requests get 403.
# Local default: http://localhost:8080,http://localhost:5173. Production: your web app's public origin.
CORS_ALLOWED_ORIGINS=

# ---- Local-only settings ---------------------------------------------------------------------
# dev: demo data, dev token endpoint and a local HS256 key. Leave empty outside a laptop.
SPRING_PROFILES_ACTIVE=dev
# Local HS256 signing key for the dev profile. At least 32 bytes.
JWT_SECRET=
# Admin password for the local Keycloak (sso profile only).
KEYCLOAK_ADMIN_PASSWORD=
# Frontend build settings. Use VITE_DEV_LOGIN=true with the dev profile; VITE_OIDC_* for SSO.
VITE_DEV_LOGIN=true
VITE_OIDC_ISSUER=http://localhost:8180/realms/dispute-portal
VITE_OIDC_CLIENT_ID=dispute-portal-web
# Only for networks that inspect HTTPS: file name inside backend/certs/ (see backend/certs/README.md).
EXTRA_CA_CERT=
